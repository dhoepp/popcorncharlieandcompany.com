---
// Banner text lives in site-content/banner.txt so non-developers can edit it.
// glob (instead of a direct import) keeps the build working if the file is deleted.
const files = import.meta.glob("/site-content/banner.txt", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;
// Normalize Windows line endings; CSS (white-space: pre-line) keeps the line breaks.
const text = (Object.values(files)[0] ?? "").replace(/\r\n?/g, "\n").trim();
---

{text && <div class="announcement-banner">{text}</div>}

<style>
  .announcement-banner {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    background: #ed1b24; /* matches the red stripes in the flavor list image */
    color: #fff;
    text-align: center;
    font-family: inherit;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    padding: 10px 16px;
    box-sizing: border-box;
    white-space: pre-line;
  }
</style>
